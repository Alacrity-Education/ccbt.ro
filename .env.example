# Postgres connection string. `generate:types` and `npm run dev` read this directly.
DATABASE_URI=postgresql://payload:payload@127.0.0.1:5434/ccbt


# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# SMTP, for the notification a form sends when someone submits it. Leave unset
# and Payload logs the message instead of sending it, which is what local
# development wants — the submission is still saved either way.
#
# SMTP_FROM_ADDRESS has to be a mailbox on a domain you control, or the mail is
# rejected or filed as spam: the visitor's own address goes in the form's
# Reply-To, never in From. See the Emails tab on any form.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@ccbt.ro
SMTP_FROM_NAME=Centrul Cultural Botoșani

# The sites allowed to post a form here. ccbt.ro is hosted separately from the
# CMS, so its forms are cross-origin and the browser blocks them unless the
# origin is listed. Comma-separated, scheme and host, no trailing slash.
PUBLIC_FORM_ORIGINS=https://ccbt.ro,https://www.ccbt.ro
